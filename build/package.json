{
  "name": "content-engine",
  "private": true,
  "version": "0.1.0",
  "description": "Content Engine — fuel for your feed. Single-user local content sourcing tool.",
  "scripts": {
    "dev": "concurrently -k -n server,web \"bun --watch server/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "bun server/index.ts",
    "test": "bun test test/unit test/integration",
    "test:live": "LIVE=1 bun test --timeout 120000 test/live"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
